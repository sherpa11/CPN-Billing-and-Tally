# =============================================================================
# CPN VEGETABLES - SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Wholesale Billing & Management System (Dindigul Market)
#
# Instructions:
# 1. Copy this file to `server/.env` (or root `.env`)
# 2. Replace the placeholder values with your actual Atlas URI and JWT secret
# 3. NEVER commit your actual `.env` file to version control
# =============================================================================

# Server Environment
NODE_ENV=production
PORT=5000

# MongoDB Atlas Connection URI
# Example format:
# mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/cpn_vegetables_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/cpn_vegetables_db?retryWrites=true&w=majority

# Isolated Test Database URI (strictly used during automated tests)
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/cpn_vegetables_test_db

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_64_character_secret_string
JWT_EXPIRES_IN=30d

# Allowed CORS Origins (comma-separated or '*' for local network access)
CORS_ORIGIN=*
